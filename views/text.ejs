<!DOCTYPE html>
<html lang="en">
<%- include('functions/functions' ); %>

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/css/main.css">
        <link rel="stylesheet" href="/css/text.css">
        <script src='/js/text.js'></script>
        <title>View Users</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>


    <body>

        <!-- Minimal header -->
        <nav class="navbar sticky-top">
            <div class="container reader-container">
                <a class="navbar-brand brand mb-0" href="#">LECTORI</a>
                <span class="small accent">VERGIL · AENEID</span>
            </div>
        </nav>

        <main class="container reader-container py-4">

            <!-- Page heading -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="section-label">P. Vergilius Maro</div>
                    <h1 class="h5 mt-1 mb-0">
                        <span>Aeneid</span>
                        <span>I</span>
                    </h1>

                    <div class="small accent">
                        Lines 1 – <%= endLine %>
                    </div>
                </div>

            </div>

            <div class="row g-4">
                <!-- Latin text -->
                <div class="col-lg-6">

                    <div class="panel p-3 p-md-4">

                        <div class="latin-text  ">

                            <%for (let lineNumber=startLine; lineNumber <=endLine; lineNumber++) { %>
                                <div class=" line ">
                                    <span class="line-number">
                                        <%= lineNumber %>
                                    </span>
                                    <div class="latin-line ">

                                        <% let lineWords=text.filter(x=>x.line_number == lineNumber).sort((a, b) =>
                                            a.order_of_text - b.order_of_text) %>
                                            <%for (let j=0; j < lineWords.length; j++) { %>
                                                <span class='word latin'>
                                                    <%= lineWords[j].word %>
                                                </span>
                                                <% } %>
                                    </div>
                                </div>
                                <% } %>

                        </div>
                    </div>

                </div>

                <div class="col-lg-6">
                    <aside class="sidebar">

                        <!-- vocab -->
                        <div class="panel p-3 mb-3">

                            <div class="d-flex justify-content-between mb-2">
                                <span class="section-label">VOCABULARY</span>
                            </div>

                            <% for (let i=0; i < text.length; i++) { %>
                                <% let word=text[i] %>

                                    <div class="vocab-entry ">
                                        <span class='entry latin text-strong'>
                                            <%- parseVocabEntry(word.primary_entry) %>
                                        </span>
                                        <span class="entry-definition text-italic">
                                            <%- parseVocabEntry(word.primary_definition) %>
                                        </span>
                                    </div>

                                    <% if(word.secondary_entry) { %>
                                        <div class="vocab-entry">
                                            <span class='entry latin text-strong'>
                                                <%- parseVocabEntry(word.secondary_entry) %>
                                            </span>
                                            <span class="entry-definition text-italic">
                                            <%- parseVocabEntry(word.secondary_definition) %>
                                            </span>
                                        </div>
                                        <% } %>
                                            <% } %>

                        </div>

                        <!-- commentary -->
                        <div class="panel p-3 ">
                            <!-- <%= JSON.stringify(commentary) %> -->

                            <div class="d-flex justify-content-between mb-2">
                                <span class="section-label">COMMENTARY</span>
                            </div>

                            <% for (let i=0; i < commentary.length; i++) { %>
                                <% let note=commentary[i] %>
                                    <div class="note-entry" note-id="<%= note.note_id %>">
                                        <span class='entry latin text-strong'>
                                            <%= getNoteLabel(note.words, note.lines) %>
                                        </span>
                                        <span class="note-text">
                                            <%- parseNote(note.commentary_text) %>
                                        </span>
                                    </div>
                                    <% } %>


                        </div>


                    </aside>
                </div>

            </div>

            <!-- Bottom navigation -->
            <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                <span class="small accent">← Previous passage</span>
                <span class="small accent">Next passage →</span>
            </div>

        </main>

    </body>

</html>